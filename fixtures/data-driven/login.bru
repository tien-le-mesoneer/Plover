meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{host}}/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("logins", (bru.getVar("logins") || 0) + 1);
}
