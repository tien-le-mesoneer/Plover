// Grammar for `.bru` files, ported from Bruno's `packages/bruno-lang/v2/src`
// (`bruToJson.js`, `envToJson.js`). No implicit WHITESPACE: every byte is
// matched explicitly so the document can be written back unchanged.

nl = _{ "\r"? ~ "\n" }
hs = _{ " " | "\t" }

// ---- Top level: a file is blocks separated by whitespace ("trivia").
file    = { SOI ~ bom? ~ (trivia | block)* ~ EOI }
bom     = { "\u{FEFF}" }
trivia  = { (" " | "\t" | "\r" | "\n")+ }
block   = { line_block | brace_block | bracket_block }

// `name {` ... a line that is exactly `}` (Bruno's `tagend = nl "}"`).
brace_block   = { block_name ~ hs* ~ "{" ~ brace_body ~ nl ~ "}" }
brace_body    = { (!(nl ~ "}") ~ ANY)* }
// `name [` ... `]` (environment `vars:secret`, `extends`).
bracket_block = { block_name ~ hs* ~ "[" ~ bracket_body ~ "]" }
bracket_body  = { (!"]" ~ ANY)* }
// Single-line environment entries: `color: #fff`, `extends: base`.
line_block    = { line_name ~ ":" ~ line_value }
line_name     = { "color" | "extends" }
line_value    = { (!nl ~ ANY)* }
block_name    = @{ (!(" " | "\t" | "\r" | "\n" | "{" | "[") ~ ANY)+ }

// ---- Dictionary block content (the text between `{` and the closing `}` line).
dict        = { SOI ~ (blank | pair)* ~ EOI }
assert_dict = { SOI ~ (blank | assert_pair)* ~ EOI }
blank       = _{ hs* ~ nl | hs+ ~ &EOI }

pair        = { hs* ~ annotations ~ hs* ~ disabled? ~ key ~ hs* ~ ":" ~ hs* ~ value ~ hs* ~ (nl | &EOI) }
assert_pair = { hs* ~ annotations ~ hs* ~ disabled? ~ assert_key ~ ":" ~ hs* ~ value ~ hs* ~ (nl | &EOI) }

disabled    = { "~" }
key         = _{ quoted_key | plain_key }
quoted_key  = ${ "\"" ~ quoted_inner ~ "\"" }
quoted_inner = @{ ("\\\"" | !("\"" | "\r" | "\n") ~ ANY)* }
plain_key   = @{ (!(" " | "\t" | "\r" | "\n" | ":") ~ ANY)* }
assert_key  = @{ (!("\r" | "\n" | ":") ~ ANY)* }

value           = _{ list_value | multiline_value | single_value }
list_value      = { "[" ~ nl+ ~ list_items? ~ hs* ~ nl+ ~ hs* ~ "]" }
list_items      = _{ list_item ~ (nl+ ~ list_item)* }
list_item       = _{ hs+ ~ list_word ~ hs* }
list_word       = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
multiline_value = { "'''" ~ ml_content ~ "'''" ~ hs* ~ content_type? }
ml_content      = @{ (!"'''" ~ ANY)* }
content_type    = { "@contentType(" ~ ct_inner ~ ")" }
ct_inner        = @{ (!")" ~ ANY)* }
single_value    = @{ (!nl ~ ANY)* }

annotations     = { annotation_line* }
annotation_line = _{ hs* ~ annotation ~ !":" ~ hs* ~ nl }
annotation      = ${ "@" ~ ann_name ~ ("(" ~ ann_arg ~ ")")? }
ann_name        = @{ (!("(" | ")" | " " | "\t" | "\r" | "\n" | ":") ~ ANY)+ }
ann_arg         = _{ ann_multi | ann_sq | ann_dq | ann_raw }
ann_multi       = ${ "'''" ~ ann_multi_inner ~ "'''" }
ann_multi_inner = @{ (!"'''" ~ ANY)* }
ann_sq          = ${ "'" ~ ann_sq_inner ~ "'" }
ann_sq_inner    = @{ (!"'" ~ ANY)* }
ann_dq          = ${ "\"" ~ ann_dq_inner ~ "\"" }
ann_dq_inner    = @{ ("\\" ~ ANY | !"\"" ~ ANY)* }
ann_raw         = @{ (!")" ~ ANY)* }
