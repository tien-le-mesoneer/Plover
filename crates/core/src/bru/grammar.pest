// Grammar for `.bru` files, ported from Bruno's `packages/bruno-lang/v2/src`
// (`bruToJson.js`, `envToJson.js`). No implicit WHITESPACE: every byte is
// matched explicitly so the document can be written back unchanged.

nl = _{ "\r"? ~ "\n" }
hs = _{ " " | "\t" }

// ---- Top level: a file is blocks separated by whitespace ("trivia").
file    = { SOI ~ bom? ~ (trivia | block)* ~ EOI }
bom     = { "\u{FEFF}" }
trivia  = { (" " | "\t" | "\r" | "\n")+ }
block   = { line_block | text_brace_block | assert_brace_block | dict_brace_block | brace_block | bracket_block }
tagend  = _{ nl ~ "}" }

// Text blocks (Bruno `textblock`): content ends at the first line that is exactly `}`.
text_brace_block = { text_name ~ hs* ~ "{" ~ brace_body ~ tagend }
text_name = @{
    ( "body:graphql:vars" | "body:graphql" | "body:sparql" | "body:json" | "body:text" | "body:xml"
    | "body" | "tests" | "docs" | "example" | "script:" ~ (!(" " | "\t" | "\r" | "\n" | "{") ~ ANY)+ )
    ~ &(hs | "{")
}
// Dictionary blocks (Bruno `dictionary`): scanned pair by pair, so a `'''` value or
// annotation argument may contain a column-0 `}` line (bruToJson.js:66, :78).
assert_brace_block = { assert_name ~ hs* ~ "{" ~ assert_body ~ tagend }
assert_name        = { "assert" ~ &(hs | "{") }
dict_brace_block   = { block_name ~ hs* ~ "{" ~ dict_body ~ tagend }
// Anything else that is brace-delimited: ends at the first `}` line; content stays opaque.
brace_block   = { block_name ~ hs* ~ "{" ~ brace_body ~ tagend }
brace_body    = { (!tagend ~ ANY)* }
// `name [` ... `]` (environment `vars:secret`, `extends`).
bracket_block = { block_name ~ hs* ~ "[" ~ bracket_body ~ "]" }
bracket_body  = { (!"]" ~ ANY)* }
// Single-line environment entries: `color: #fff`, `extends: base`.
line_block    = { line_name ~ ":" ~ line_value }
line_name     = { "color" | "extends" }
line_value    = { (!nl ~ ANY)* }
block_name    = @{ (!(" " | "\t" | "\r" | "\n" | "{" | "[") ~ ANY)+ }

// ---- Dictionary block content. The same rules run inside a block (stopping
// at `tagend`) and on an extracted body (stopping at EOI).
dict        = { SOI ~ dict_body ~ EOI }
assert_dict = { SOI ~ assert_body ~ EOI }
dict_body   = { (blank | pair)* }
assert_body = { (blank | assert_pair)* }
body_end    = _{ &tagend | &EOI }
blank       = _{ hs+ ~ body_end | hs* ~ !tagend ~ nl }
pair_end    = _{ !tagend ~ nl | body_end }

pair        = { hs* ~ annotations ~ hs* ~ disabled? ~ key ~ hs* ~ ":" ~ hs* ~ value ~ hs* ~ pair_end }
assert_pair = { hs* ~ annotations ~ hs* ~ disabled? ~ assert_key ~ ":" ~ hs* ~ value ~ hs* ~ pair_end }

disabled    = { "~" }
key         = _{ quoted_key | plain_key }
quoted_key  = ${ "\"" ~ quoted_inner ~ "\"" }
quoted_inner = @{ ("\\\"" | !("\"" | "\r" | "\n") ~ ANY)* }
plain_key   = @{ (!(" " | "\t" | "\r" | "\n" | ":") ~ ANY)* }
assert_key  = @{ (!("\r" | "\n" | ":") ~ ANY)* }

value           = _{ list_value | multiline_value | single_value }
list_value      = { "[" ~ nl+ ~ list_items? ~ hs* ~ nl+ ~ hs* ~ "]" }
list_items      = _{ list_item ~ (nl+ ~ list_item)* }
list_item       = _{ hs+ ~ list_word ~ hs* }
list_word       = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
multiline_value = { "'''" ~ ml_content ~ "'''" ~ hs* ~ content_type? }
ml_content      = @{ (!"'''" ~ ANY)* }
content_type    = { "@contentType(" ~ ct_inner ~ ")" }
ct_inner        = @{ (!")" ~ ANY)* }
single_value    = @{ (!nl ~ ANY)* }

annotations     = { annotation_line* }
annotation_line = _{ hs* ~ annotation ~ !":" ~ hs* ~ nl }
annotation      = ${ "@" ~ ann_name ~ ("(" ~ ann_arg ~ ")")? }
ann_name        = @{ (!("(" | ")" | " " | "\t" | "\r" | "\n" | ":") ~ ANY)+ }
ann_arg         = _{ ann_multi | ann_sq | ann_dq | ann_raw }
ann_multi       = ${ "'''" ~ ann_multi_inner ~ "'''" }
ann_multi_inner = @{ (!"'''" ~ ANY)* }
ann_sq          = ${ "'" ~ ann_sq_inner ~ "'" }
ann_sq_inner    = @{ (!"'" ~ ANY)* }
ann_dq          = ${ "\"" ~ ann_dq_inner ~ "\"" }
ann_dq_inner    = @{ ("\\" ~ ANY | !"\"" ~ ANY)* }
ann_raw         = @{ (!")" ~ ANY)* }
