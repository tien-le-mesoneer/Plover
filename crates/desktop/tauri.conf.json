{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plover",
  "version": "0.1.0",
  "identifier": "dev.plover.app",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
